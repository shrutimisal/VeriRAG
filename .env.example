# Copy this file to ".env" and fill in your key. NEVER commit ".env".
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used for answers, verification and RAGAS judging.
# Check https://ai.google.dev/gemini-api/docs/models for currently available names.
GEMINI_MODEL=gemini-3.8-flash

# Local embedding model (downloaded automatically on first run, ~90 MB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking + retrieval defaults (can also be changed in the UI sidebar)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# Where ChromaDB persists vectors on disk
CHROMA_DIR=data/chroma_db

# RAGAS: number of questions generated per answer for Answer Relevancy.
# 1 is cheap/free-tier friendly; ragas' own default is 3 (more stable, more API calls).
RAGAS_RELEVANCY_STRICTNESS=1
